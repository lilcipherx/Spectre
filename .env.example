# ---- Spectre tactical STT module ----
# Copy to .env and fill in real values.

# ElevenLabs API key (required unless SPECTRE_DRY_RUN=1).
# Get one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# STT language.  "uz" = Uzbek.  Other codes from:
# https://elevenlabs.io/docs/overview/capabilities/speech-to-text#supported-languages
SPECTRE_LANGUAGE=uz

# Which ALSA capture device to read from.
# Find yours with `arecord -l` / `arecord -L`.  Examples:
#   plughw:CARD=Audio,DEV=0   # named (most robust, survives card-N changes)
#   plughw:2,0                # numeric (must match the actual card index)
#   default
SPECTRE_AUDIO_DEVICE=plughw:CARD=Audio,DEV=0

# Microphone gain multiplier applied to raw PCM before sending upstream.
# 1.0 = pass-through.  Use values >1 for quiet radios, <1 for hot signals.
SPECTRE_AUDIO_GAIN=1.5

# Voice-activity parameters (seconds).  Tune for your radio's squelch behaviour.
SPECTRE_VAD_SILENCE_SEC=0.6
SPECTRE_VAD_THRESHOLD=0.4
SPECTRE_MIN_SPEECH_MS=200
SPECTRE_MIN_SILENCE_MS=400

# Display driver:
#   "fb1"      = paint into the kernel framebuffer (/dev/fb1) created by the
#                fbtft dtoverlay.  This is the default and the right choice on
#                Pi OS Trixie where fbtft owns the SPI bus.  Backlight and
#                panel reset are handled by the kernel for us.
#   "ili9341"  = drive the panel directly via luma.lcd over /dev/spidev0.0.
#                Only works if there is NO fbtft dtoverlay enabled.
#   "console"  = print transcripts to stdout (laptop dev).
SPECTRE_DISPLAY=fb1

# Path to the framebuffer device when SPECTRE_DISPLAY=fb1.
SPECTRE_FB_PATH=/dev/fb1

# SPI wiring (only used when SPECTRE_DISPLAY=ili9341).
SPECTRE_SPI_PORT=0
SPECTRE_SPI_DEVICE=0
SPECTRE_GPIO_DC=24
SPECTRE_GPIO_RST=25
# Software-side rotation for the ili9341 backend.
# 0 = portrait 240x320, 1 = landscape 320x240, 2/3 = flipped.
SPECTRE_DISPLAY_ROTATE=1

# Size of the on-screen text buffer (how many words we keep in history).
SPECTRE_BUFFER_WORDS=120

# When 1, Spectre runs entirely offline and prints transcripts to stdout.
# Useful for unit tests and CI.
SPECTRE_DRY_RUN=0
